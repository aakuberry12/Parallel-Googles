{
  "name": "parallel-googles",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Search the same question across countries and measure how results diverge.",
  "scripts": {
    "install:all": "npm install && npm --prefix client install",
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit -p server && npm --prefix client run typecheck",
    "test": "tsx --test server/tests/*.test.ts",
    "check": "npm test && npm run typecheck && npm run build"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
