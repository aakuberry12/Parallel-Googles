# --- Required for live searches ---------------------------------------------
# Get a key at https://serpapi.com/manage-api-key . Without it the app runs in
# clearly labelled DEMO MODE with synthetic sample data.
SERPAPI_KEY=

# --- Optional: force demo mode even when a key exists -----------------------
DEMO_MODE=false

# --- Optional: AI explanations (rule-based summary is used when unset) ------
# LLM_PROVIDER=anthropic | openai
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=claude-sonnet-4-5

# --- Server ------------------------------------------------------------------
PORT=3001
# Max simultaneous SerpApi requests per search, and per-request timeout (ms)
SERPAPI_CONCURRENCY=4
SERPAPI_TIMEOUT_MS=20000
# Searches allowed per IP per minute (each search = one SerpApi credit per country)
RATE_LIMIT_PER_MIN=6
